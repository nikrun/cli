unit nik.gen.manifest;

{$mode objfpc}{$H+}

{ Source text of the generated unit 'nikmanifest' (see internal-notes/specs/nik-yaml.md, section 6).
  Pure text generation; the caller writes the file into the project build cache. }

interface

uses
  SysUtils, nik.types, nik.manifest.types;

const
  NIKMANIFEST_UNIT_NAME   = 'nikmanifest';
  NIKMANIFEST_UNIT_FILE   = 'nikmanifest.pas';
  NIKMANIFEST_RESOURCE_FILE = 'windows.res';

{ Pascal string constant literal for AText: single-quoted, quotes doubled, control characters as #NN. }
function PascalStringLiteral(const AText: string): string;

{ AVersionText is the effective version (manifest version or --build-version); AHasResource adds the
  {$R windows.res} line (Windows builds that have a windows section). }
function BuildNikManifestUnitSource(const AManifest: TResolvedManifest; const AVersionText,
  ATargetTriplet, AFpcVersion: string; AHasResource: Boolean): string;

implementation

function PascalStringLiteral(const AText: string): string;
var
  I: Integer;
  InQuote: Boolean;
  C: Char;
begin
  if AText = '' then
    Exit('''''');
  Result := '';
  InQuote := False;
  for I := 1 to Length(AText) do
  begin
    C := AText[I];
    if C < ' ' then
    begin
      if InQuote then
      begin
        Result := Result + '''';
        InQuote := False;
      end;
      Result := Result + '#' + IntToStr(Ord(C));
    end
    else
    begin
      if not InQuote then
      begin
        Result := Result + '''';
        InQuote := True;
      end;
      if C = '''' then
        Result := Result + ''''''
      else
        Result := Result + C;
    end;
  end;
  if InQuote then
    Result := Result + '''';
end;

function JoinAuthors(const AAuthors: TStringArray): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(AAuthors) do
  begin
    if I > 0 then
      Result := Result + ', ';
    Result := Result + AAuthors[I];
  end;
end;

function BuildNikManifestUnitSource(const AManifest: TResolvedManifest; const AVersionText,
  ATargetTriplet, AFpcVersion: string; AHasResource: Boolean): string;
var
  V: TWindowsVersion;
  VersionText: string;

  procedure AddLine(const ALine: string);
  begin
    Result := Result + ALine + LineEnding;
  end;

  procedure AddStr(const AName, AValue: string);
  begin
    AddLine(Format('  %s = %s;', [AName, PascalStringLiteral(AValue)]));
  end;

  procedure AddInt(const AName: string; AValue: Integer);
  begin
    AddLine(Format('  %s = %d;', [AName, AValue]));
  end;

begin
  VersionText := Trim(AVersionText);
  if VersionText = '' then
    VersionText := '0.1.0';
  TryDeriveWindowsVersion(VersionText, V);

  Result := '';
  AddLine('{ Generated by nik. Do not edit. }');
  AddLine('unit ' + NIKMANIFEST_UNIT_NAME + ';');
  AddLine('');
  AddLine('{$mode objfpc}{$H+}');
  AddLine('');
  AddLine('interface');
  AddLine('');
  AddLine('const');
  AddStr('ProjectKind', ManifestKindToString(AManifest.Kind));
  AddStr('ProjectName', AManifest.ProjectName);
  AddStr('ProjectVersion', VersionText);
  AddInt('ProjectVersionMajor', V[0]);
  AddInt('ProjectVersionMinor', V[1]);
  AddInt('ProjectVersionPatch', V[2]);
  AddInt('ProjectVersionBuild', V[3]);
  AddStr('ProjectDescription', AManifest.Description);
  AddStr('ProjectLicense', AManifest.License);
  AddStr('ProjectRepository', AManifest.Repository);
  AddStr('ProjectAuthors', JoinAuthors(AManifest.Authors));
  AddStr('BuildProfile', AManifest.ProfileName);
  AddStr('BuildTarget', ATargetTriplet);
  AddStr('BuildFpcVersion', AFpcVersion);
  AddLine('');
  AddLine('implementation');
  AddLine('');
  if AHasResource then
  begin
    AddLine('{$IFDEF WINDOWS}');
    AddLine('{$R ' + NIKMANIFEST_RESOURCE_FILE + '}');
    AddLine('{$ENDIF}');
    AddLine('');
  end;
  AddLine('end.');
end;

end.
