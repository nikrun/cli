unit nik.test.runner;

{$mode objfpc}{$H+}

{ Generates the fpcunit runner program and reporter unit used by 'nik test' (see
  internal-notes/specs/nik-test.md). Files are only rewritten when their content changes so that
  compiled units in the checkout-local cache keep their timestamps. }

interface

uses
  SysUtils, nik.types, nik.test.discovery;

type
  TGeneratedRunner = record
    RunnerDir: string;
    ProgramPath: string;
    ReporterPath: string;
    IdsFilePath: string;
  end;

{ Directory holding the SDK-independent generated runner sources for a profile. }
function GetTestRunnerDir(const AProjectDir, AProfileName: string): string;

function BuildRunnerProgramSource(const AUnits: TTestUnitInfoArray): string;

function GenerateTestRunner(const AProjectDir, AProfileName: string;
  const AUnits: TTestUnitInfoArray): TGeneratedRunner;

{ Writes one lower-case test id per line (read by the runner via --ids-file). }
procedure WriteRunnerIdsFile(const APath: string; const AIds: TStringArray);

implementation

uses
  nik.paths, nik.fs, nik.project;

const
  {$I nik.test.reporter.inc}

function GetTestRunnerDir(const AProjectDir, AProfileName: string): string;
begin
  Result := JoinPath(JoinPath(JoinPath(AProjectDir, '.nik'), 'cache'),
    'test-runner-' + SanitizeCacheKey(AProfileName));
end;

function BuildRunnerProgramSource(const AUnits: TTestUnitInfoArray): string;
var
  I: Integer;
  UsesList: string;
begin
  UsesList := 'SysUtils, fpcunit, testregistry, nikrun_test_reporter';
  for I := 0 to High(AUnits) do
    if Length(AUnits[I].Classes) > 0 then
      UsesList := UsesList + ',' + LineEnding + '  ' + AUnits[I].UnitName;

  Result :=
    '{ Generated by nik test - do not edit. }' + LineEnding +
    'program nik_test_runner;' + LineEnding +
    LineEnding +
    '{$mode objfpc}{$H+}' + LineEnding +
    LineEnding +
    'uses' + LineEnding +
    '  ' + UsesList + ';' + LineEnding +
    LineEnding +
    'begin' + LineEnding +
    '  ExitCode := NikRunRegisteredTests;' + LineEnding +
    'end.' + LineEnding;
end;

procedure WriteIfChanged(const APath, AContent: string);
var
  Existing: string;
begin
  if FileExists(APath) then
  begin
    try
      Existing := ReadFileTextUtf8(APath);
    except
      Existing := '';
    end;
    if Existing = AContent then
      Exit;
  end;
  WriteFileTextUtf8(APath, AContent);
end;

function GenerateTestRunner(const AProjectDir, AProfileName: string;
  const AUnits: TTestUnitInfoArray): TGeneratedRunner;
begin
  Result := Default(TGeneratedRunner);
  Result.RunnerDir := GetTestRunnerDir(AProjectDir, AProfileName);
  EnsureDirExists(Result.RunnerDir);
  Result.ProgramPath := JoinPath(Result.RunnerDir, 'nik_test_runner.pas');
  Result.ReporterPath := JoinPath(Result.RunnerDir, 'nikrun_test_reporter.pas');
  Result.IdsFilePath := JoinPath(Result.RunnerDir, 'ids.txt');

  WriteIfChanged(Result.ReporterPath, TEST_REPORTER_SOURCE + LineEnding);
  WriteIfChanged(Result.ProgramPath, BuildRunnerProgramSource(AUnits));
end;

procedure WriteRunnerIdsFile(const APath: string; const AIds: TStringArray);
var
  I: Integer;
  Content: string;
begin
  Content := '';
  for I := 0 to High(AIds) do
    Content := Content + LowerCase(AIds[I]) + LineEnding;
  WriteFileTextUtf8(APath, Content);
end;

end.
