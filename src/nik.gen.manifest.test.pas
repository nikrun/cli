unit nik.gen.manifest.test;

{$mode objfpc}{$H+}

interface

uses
  SysUtils, fpcunit, testregistry, nik.types, nik.manifest.types, nik.gen.manifest;

type
  TGenManifestTests = class(TTestCase)
  published
    procedure TestStringLiteralQuotesAndControlCharacters;
    procedure TestUnitSourceContainsAllConstants;
    procedure TestUnitSourceDerivesVersionParts;
    procedure TestUnitSourceFallsBackToDefaultVersion;
    procedure TestUnitSourceResourceLineIsOptional;
    procedure TestUnitSourceForLibrary;
  end;

implementation

function Manifest: TResolvedManifest;
begin
  Result := Default(TResolvedManifest);
  Result.Kind := mkProgram;
  Result.ProjectName := 'my-app';
  Result.Description := 'Sample ''quoted'' app';
  Result.License := 'MIT';
  Result.Repository := 'https://github.com/example/my-app';
  Result.ProfileName := 'release';
  SetLength(Result.Authors, 2);
  Result.Authors[0] := 'Jane Doe';
  Result.Authors[1] := 'John Roe';
end;

procedure TGenManifestTests.TestStringLiteralQuotesAndControlCharacters;
begin
  AssertEquals('''''', PascalStringLiteral(''));
  AssertEquals('''plain''', PascalStringLiteral('plain'));
  AssertEquals('''it''''s''', PascalStringLiteral('it''s'));
  AssertEquals('''a''#10''b''', PascalStringLiteral('a' + #10 + 'b'));
  AssertEquals('#13#10', PascalStringLiteral(#13#10));
  AssertEquals('''x''#9', PascalStringLiteral('x' + #9));
end;

procedure TGenManifestTests.TestUnitSourceContainsAllConstants;
var
  Src: string;
begin
  Src := BuildNikManifestUnitSource(Manifest, '1.4.2', 'x86_64-win64', '3.3.1', False);
  AssertTrue(Pos('{ Generated by nik. Do not edit. }', Src) = 1);
  AssertTrue(Pos('unit nikmanifest;', Src) > 0);
  AssertTrue(Pos('  ProjectKind = ''program'';', Src) > 0);
  AssertTrue(Pos('  ProjectName = ''my-app'';', Src) > 0);
  AssertTrue(Pos('  ProjectVersion = ''1.4.2'';', Src) > 0);
  AssertTrue(Pos('  ProjectDescription = ''Sample ''''quoted'''' app'';', Src) > 0);
  AssertTrue(Pos('  ProjectLicense = ''MIT'';', Src) > 0);
  AssertTrue(Pos('  ProjectRepository = ''https://github.com/example/my-app'';', Src) > 0);
  AssertTrue(Pos('  ProjectAuthors = ''Jane Doe, John Roe'';', Src) > 0);
  AssertTrue(Pos('  BuildProfile = ''release'';', Src) > 0);
  AssertTrue(Pos('  BuildTarget = ''x86_64-win64'';', Src) > 0);
  AssertTrue(Pos('  BuildFpcVersion = ''3.3.1'';', Src) > 0);
  AssertTrue(Pos('end.', Src) > 0);
end;

procedure TGenManifestTests.TestUnitSourceDerivesVersionParts;
var
  Src: string;
begin
  Src := BuildNikManifestUnitSource(Manifest, 'v0.2.0-build.16-channel.stable', 't', 'f', False);
  AssertTrue(Pos('  ProjectVersion = ''v0.2.0-build.16-channel.stable'';', Src) > 0);
  AssertTrue(Pos('  ProjectVersionMajor = 0;', Src) > 0);
  AssertTrue(Pos('  ProjectVersionMinor = 2;', Src) > 0);
  AssertTrue(Pos('  ProjectVersionPatch = 0;', Src) > 0);
  AssertTrue(Pos('  ProjectVersionBuild = 16;', Src) > 0);

  Src := BuildNikManifestUnitSource(Manifest, 'nightly', 't', 'f', False);
  AssertTrue(Pos('  ProjectVersion = ''nightly'';', Src) > 0);
  AssertTrue('unparseable versions give zero parts', Pos('  ProjectVersionMajor = 0;', Src) > 0);
  AssertTrue(Pos('  ProjectVersionBuild = 0;', Src) > 0);
end;

procedure TGenManifestTests.TestUnitSourceFallsBackToDefaultVersion;
var
  Src: string;
begin
  Src := BuildNikManifestUnitSource(Manifest, '  ', 't', 'f', False);
  AssertTrue(Pos('  ProjectVersion = ''0.1.0'';', Src) > 0);
  AssertTrue(Pos('  ProjectVersionMinor = 1;', Src) > 0);
end;

procedure TGenManifestTests.TestUnitSourceResourceLineIsOptional;
var
  With_, Without: string;
begin
  With_ := BuildNikManifestUnitSource(Manifest, '1.0.0', 't', 'f', True);
  Without := BuildNikManifestUnitSource(Manifest, '1.0.0', 't', 'f', False);
  AssertTrue(Pos('{$IFDEF WINDOWS}' + LineEnding + '{$R windows.res}' + LineEnding + '{$ENDIF}', With_) > 0);
  AssertEquals(0, Pos('{$R', Without));
end;

procedure TGenManifestTests.TestUnitSourceForLibrary;
var
  M: TResolvedManifest;
begin
  M := Manifest;
  M.Kind := mkLibrary;
  AssertTrue(Pos('  ProjectKind = ''library'';', BuildNikManifestUnitSource(M, '1.0.0', 't', 'f', False)) > 0);
end;

initialization
  RegisterTest(TGenManifestTests);
end.
